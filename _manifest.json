{
  "manifest_version": 2,
  "id": "mai-beeper.beeper-adapter",
  "version": "0.4.3",
  "name": "Mai Beeper Adapter",
  "description": "讓 MaiBot 透過 Beeper Desktop API 收發文字、圖片與語音，並以聊天室名稱和配對文字管理白名單。",
  "author": {
    "name": "sunfish1728",
    "url": "https://github.com/sunfish1728"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/sunfish1728/mai-beeper-adapter",
    "homepage": "https://github.com/sunfish1728/mai-beeper-adapter",
    "documentation": "https://github.com/sunfish1728/mai-beeper-adapter/blob/main/README.md",
    "issues": "https://github.com/sunfish1728/mai-beeper-adapter/issues"
  },
  "plugin_type": "adapter",
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.2.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-TW",
    "supported_locales": ["zh-TW"]
  }
}
